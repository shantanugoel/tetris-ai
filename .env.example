# Copy to .env — the CLI agents read it automatically. .env is gitignored.

# TypeSafe "Jev" (tools/jev-play.js). Key: https://console.typesafe.ai/settings/keys
# (or via Vercel AI Gateway). Early access is waitlisted.
TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0            # pin it if you tune --min-confidence thresholds
# JEV_URL=https://api.typesafe.ai/v1/systemone

# Any OpenAI-compatible chat endpoint (tools/llm-play.js):
#   OpenAI     OPENAI_BASE_URL=https://api.openai.com/v1        OPENAI_MODEL=gpt-4o-mini
#   OpenRouter OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Groq       OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Ollama     OPENAI_BASE_URL=http://127.0.0.1:11434/v1        OPENAI_API_KEY=ollama OPENAI_MODEL=llama3.1
#   LM Studio  OPENAI_BASE_URL=http://127.0.0.1:1234/v1         OPENAI_API_KEY=lm-studio
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Where the game server listens (also: `node server.js 8787`).
# PORT=8787
